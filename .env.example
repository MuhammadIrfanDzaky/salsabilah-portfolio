# Salin file ini menjadi .env.local, lalu isi nilainya.
# .env.local sudah diabaikan git — jangan pernah commit nilai aslinya.

# ------------------------------------------------------------------- Situs
# Domain produksi, tanpa garis miring di akhir. Dipakai untuk canonical,
# hreflang, OG image, sitemap, dan RSS. Boleh dikosongkan saat pengembangan —
# nilai bawaannya adalah domain produksi saat ini.
NEXT_PUBLIC_SITE_URL=https://salsabilah.vercel.app

# ---------------------------------------------------------------- Supabase
# Keduanya BOLEH terbaca browser. Setiap tabel dilindungi Row Level Security,
# jadi kunci ini sendiri tidak memberi akses apa pun di luar yang boleh dibaca
# pengunjung anonim.
# Ambil di: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ------------------------------------------------------- Formulir kontak
# ID formulir Formspree — bagian akhir dari https://formspree.io/f/<id>.
# Ambil di: https://formspree.io > New Form > salin ID dari endpoint-nya.
#
# BUKAN rahasia: ID ini wajib tampil di atribut `action` yang terbaca siapa pun,
# jadi NEXT_PUBLIC_ memang tempatnya.
#
# Dikosongkan berarti formulir kontak TIDAK dirender; bagian kontak menampilkan
# tombol kirim email langsung sebagai gantinya. Itu disengaja — sebelumnya
# nilainya di-hardcode `REPLACE_ME` dan tayang di produksi, sehingga setiap pesan
# yang dikirim pengunjung hilang tanpa satu pun pesan galat. Jangan pernah
# mengisi baris ini dengan nilai contoh; kosong lebih aman daripada salah.
#
# Isi HANYA ID-nya, bukan URL lengkapnya. Dari endpoint
# `https://formspree.io/f/abcd1234`, yang ditulis di sini adalah `abcd1234`.
# (Kode ikut memaafkan kalau URL lengkap yang tertempel, tapi tetap tulis ID-nya.)
NEXT_PUBLIC_FORMSPREE_ID=

# ------------------------------------------------------------- Terjemahan
# RAHASIA — hanya server. Jangan pernah diberi awalan NEXT_PUBLIC_,
# karena apa pun yang berawalan itu ikut terkirim ke browser.
# Ambil di: https://openrouter.ai/keys
#
# FILE INI IKUT TER-COMMIT KE GIT. Jangan pernah menaruh nilai asli di sini —
# nilai asli tempatnya di `.env.local` (diabaikan git) untuk pengembangan, dan di
# Vercel → Settings → Environment Variables untuk produksi.
OPENROUTER_API_KEY=

# Model yang dipanggil. Ditulis lengkap dengan penerbitnya — jangan pakai
# alias yang bisa berpindah sasaran diam-diam.
#
# Bawaannya model gratis. Kalau hasil terjemahannya melanggar glosarium terlalu
# sering, naikkan ke model berbayar; biayanya sekitar Rp 200-400 per artikel dan
# tidak ada yang perlu diubah selain baris ini.
#
# Sebelum mengisi: buka OpenRouter → Settings → Eligibility Preview → Show All,
# dan pastikan model yang Anda tulis berstatus tersedia. Setting privasi akun
# menutup sebagian besar endpoint gratis, jadi model yang ada di katalog belum
# tentu bisa Anda panggil.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Provider yang boleh melayani, dipisah koma. Dikosongkan berarti OpenRouter
# bebas memilih — dan bebas berpindah tanpa memberi tahu, yang membuat
# "model & versi dipin" (competency 34) jadi tidak berarti. Isi kalau Anda
# butuh kepastian provider.
OPENROUTER_PROVIDER_ORDER=

# ------------------------------------------------------ Plafon biaya (comp. 5)
# Batas token keluaran untuk SATU permintaan. Mencegah artikel yang sangat
# panjang berubah jadi satu tagihan tak terduga.
#
# HATI-HATI, angkanya bukan sekadar plafon biaya — ia juga bisa memotong hasil.
# Pada model yang "berpikir" dulu sebelum menjawab (termasuk model gratis bawaan
# di atas), token penalaran ikut dihitung ke anggaran yang sama. Terukur
# 2026-07-28: 173 dari 201 token keluaran habis untuk penalaran hanya untuk
# menerjemahkan satu kalimat enam kata. Kalau anggarannya habis di tengah jalan,
# permintaan itu ditolak seluruhnya — hasil separuh tidak pernah dipakai.
#
# Panjangnya juga tidak stabil: pada teks dan model yang sama, anggaran 240
# berhasil sementara 280 dan 320 gagal terpotong. Beri kelonggaran, jangan
# disetel mepet. Sumber dibatasi 24.000 karakter, jadi 16.000 token memberi
# ruang yang cukup untuk terjemahannya plus penalarannya.
TRANSLATION_MAX_OUTPUT_TOKENS=16000

# Batas token keluaran KUMULATIF per bulan kalender. Begitu terlampaui,
# terjemahan otomatis berhenti melayani sampai bulan berikutnya — Salsabilah
# tetap bisa menulis terjemahan manual. Angka bawaan ini setara puluhan artikel.
TRANSLATION_MONTHLY_TOKEN_CAP=400000

# ----------------------------------------------------------- Pembatas laju
# OPSIONAL. Ikut di-hash bersama alamat IP sebelum disimpan sebagai kunci
# pembatas laju. Tanpa ini aplikasi tetap jalan; yang hilang hanya satu lapis
# penyamaran — hash tanpa salt dari sebuah alamat IPv4 masih bisa dibalik
# dengan mencoba seluruh ruang alamat. Isi dengan teks acak panjang.
RATE_LIMIT_SALT=
